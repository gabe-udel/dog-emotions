# Python env (947 MB, rebuilt via the setup steps in CLAUDE.md)
.venv/
__pycache__/
*.py[cod]

# DogFLW imagery - CC BY-NC 4.0, not ours to redistribute (349 MB).
# Rebuild with: .venv/bin/python src/extract_dogflw.py
data/dogflw/

# The Kaggle download itself (1.4 GB; 'archive.zip' is Kaggle's default name).
# Same licence problem, and it is pure input - extract_dogflw.py regenerates data/dogflw
# from it. Kept out of the tree rather than deleted so re-extraction needs no re-download.
archive.zip
data/dogflw.zip
*.zip

# Model snapshots (118 MB each). Rebuild with src/extend_head.py + src/train_dogface.py
*.pt
model_weights/

# Third-party demo videos (50 MB) and scratch frames.
# Note: must be videos/* not videos/ - git cannot re-include a file whose parent dir is excluded.
videos/*
!videos/SOURCES.md

# Test clips dropped in the project root rather than videos/. Excluded by default:
# these are personal footage rather than project assets, and a binary committed here is
# permanent in the history. "Happy lab.mov" is tracked deliberately - it is the clip
# every measurement in CLAUDE.md section 11 was made on, so the numbers are reproducible.
*.mov
*.avi
*.mkv
*.webm
!Happy lab.mov

# Editor state
.vscode/

# Derived training data - regenerated in seconds by src/make_coco.py
dlc_project/

# Rendered demo videos
outputs/*.mp4

# Ad-hoc landmark-index overlays. Regenerable exactly from a --seed, and a few random
# batches would otherwise bury the two figures that are actually tracked.
outputs/figures/indices/
