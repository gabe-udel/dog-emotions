# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Which provider answers. "openai" sends sampled frames (the API has no video
# input); "gemini" sends the video file itself.
PUPCHAT_PROVIDER=openai

OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# Optional model overrides. Defaults: gpt-6.1-sol / gemini-3.8-flash
# PUPCHAT_OPENAI_MODEL=gpt-6.1-sol
# PUPCHAT_GEMINI_MODEL=gemini-3.8-flash
